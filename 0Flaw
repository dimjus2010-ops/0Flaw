                                                "Explication pédagogique",
                                            ].map((head) => (
                                                <th
                                                    key={head}
                                                    style={{
                                                        textAlign: "left",
                                                        borderBottom:
                                                            "1px solid #DEDCD2",
                                                        padding: "10px 8px",
                                                        background: "#F7F4EC",
                                                    }}
                                                >
                                                    {head}
                                                </th>
                                            ))}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {changeRows.length === 0 ? (
                                            <tr>
                                                <td
                                                    colSpan={4}
                                                    style={{ padding: 12 }}
                                                >
                                                    Aucune correction détectée
                                                    par la règle locale de
                                                    démonstration.
                                                </td>
                                            </tr>
                                        ) : (
                                            changeRows.map((row, idx) => (
                                                <tr
                                                    key={`${row.original}-${idx}`}
                                                >
                                                    <td
                                                        style={{
                                                            borderTop:
                                                                "1px solid #DEDCD2",
                                                            padding: 8,
                                                        }}
                                                    >
                                                        {row.original}
                                                    </td>
                                                    <td
                                                        style={{
                                                            borderTop:
                                                                "1px solid #DEDCD2",
                                                            padding: 8,
                                                        }}
                                                    >
                                                        {row.proposition}
                                                    </td>
                                                    <td
                                                        style={{
                                                            borderTop:
                                                                "1px solid #DEDCD2",
                                                            padding: 8,
                                                        }}
                                                    >
                                                        {row.categorie}
                                                    </td>
                                                    <td
                                                        style={{
                                                            borderTop:
                                                                "1px solid #DEDCD2",
                                                            padding: 8,
                                                        }}
                                                    >
                                                        {row.explication}
                                                    </td>
                                                </tr>
                                            ))
                                        )}
                                    </tbody>
                                </table>
                            </div>
                        </section>

                        <section style={{ marginBottom: 16 }}>
                            <h3
                                style={{
                                    ...headingStyle,
                                    margin: "0 0 8px",
                                    fontSize: 18,
                                }}
                            >
                                Alternatives complètes
                            </h3>
                            <div
                                className="plume-alternatives"
                                style={{
                                    display: "grid",
                                    gridTemplateColumns:
                                        "repeat(auto-fit, minmax(min(100%, 260px), 1fr))",
                                    gap: 12,
                                }}
                            >
                                {[
                                    {
                                        label: "A · Professionnelle",
                                        content: rewriteA,
                                    },
                                    {
                                        label: "B · Engageante",
                                        content: rewriteB,
                                    },
                                ].map((item) => (
                                    <article
                                        key={item.label}
                                        style={{
                                            border: "1px solid #DEDCD2",
                                            borderRadius: 10,
                                            background: "#FFFEFA",
                                            padding: 12,
                                        }}
                                    >
                                        <div
                                            style={{
                                                display: "flex",
                                                justifyContent: "space-between",
                                                gap: 8,
                                                marginBottom: 8,
                                            }}
                                        >
                                            <strong style={{ fontSize: 13 }}>
                                                {item.label}
                                            </strong>
                                            <button
                                                type="button"
                                                onClick={() =>
                                                    handleCopy(
                                                        item.label,
                                                        item.content
                                                    )
                                                }
                                                style={{
                                                    border: "1px solid #DEDCD2",
                                                    background: "transparent",
                                                    borderRadius: 8,
                                                    padding: "6px 8px",
                                                    fontSize: 11,
                                                    cursor: "pointer",
                                                }}
                                            >
                                                Copier
                                            </button>
                                        </div>
                                        <pre
                                            style={{
                                                margin: 0,
                                                whiteSpace: "pre-wrap",
                                                fontFamily: "inherit",
                                                fontSize: 12,
                                                lineHeight: 1.45,
                                            }}
                                        >
                                            {item.content}
                                        </pre>
                                    </article>
                                ))}
                            </div>
                            <div
                                aria-live="polite"
                                style={{ marginTop: 8, fontSize: 11 }}
                            >
                                {copyStatus || copyError}
                            </div>
                        </section>
                    </>
                )}

                <footer
                    style={{
                        marginTop: 24,
                        fontSize: 12,
                        borderTop: "1px solid #DEDCD2",
                        paddingTop: 12,
                        opacity: 0.9,
                    }}
                >
                    <strong>{brand}</strong> / L’essentiel de vos idées. Rien de
                    moins.
                </footer>
            </div>

            {modal !== null && (
                <div
                    role="presentation"
                    onClick={(event) => {
                        if (event.target === event.currentTarget) {
                            closeModal()
                        }
                    }}
                    style={{
                        position: "fixed",
                        inset: 0,
                        background: "rgba(41,46,41,0.35)",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        padding: 16,
                        zIndex: 50,
                    }}
                >
                    <div
                        className="plume-dialog"
                        ref={modalRef}
                        role="dialog"
                        aria-modal="true"
                        aria-label={
                            modal === "approval"
                                ? "Validation avant affinage"
                                : "Offre Premium simulée"
                        }
                        style={{
                            width: "100%",
                            maxWidth: 560,
                            maxHeight: "90vh",
                            overflowY: "auto",
                            background: "#FFFEFA",
                            border: "1px solid #DEDCD2",
                            borderRadius: 12,
                            padding: 18,
                        }}
                    >
                        {modal === "approval" ? (
                            <>
                                <h2
                                    style={{
                                        ...headingStyle,
                                        margin: "0 0 6px",
                                        fontSize: 22,
                                    }}
                                >
                                    Validation avant affinage
                                </h2>
                                <p style={{ margin: "0 0 10px", fontSize: 13 }}>
                                    Statut : <strong>attente validation</strong>
                                </p>
                                <p style={{ margin: "0 0 12px", fontSize: 13 }}>
                                    Stratégie proposée : conserver votre
                                    intention, corriger les points de langue
                                    explicites et ajouter seulement des
                                    compléments facultatifs. Cette étape
                                    n’infère pas d’intentions cachées et ne crée
                                    pas d’analyse personnalisée.
                                </p>
                                <div
                                    style={{
                                        display: "grid",
                                        gap: 8,
                                        marginBottom: 12,
                                    }}
                                >
                                    {additionsList.map((item, idx) => {
                                        const checked =
                                            selectedAdditions.includes(item.id)
                                        return (
                                            <label
                                                key={`${item.id}-${idx}`}
                                                style={{
                                                    display: "flex",
                                                    gap: 8,
                                                    border: "1px solid #DEDCD2",
                                                    borderRadius: 8,
                                                    padding: 8,
                                                    cursor: "pointer",
                                                }}
                                            >
                                                <input
                                                    type="checkbox"
                                                    checked={checked}
                                                    onChange={() =>
                                                        toggleAddition(item.id)
                                                    }
                                                    aria-label={`Sélectionner ajout ${idx + 1}`}
                                                />
                                                <span style={{ fontSize: 13 }}>
                                                    {item.label}
                                                </span>
                                            </label>
                                        )
                                    })}
                                </div>
                                <div
                                    style={{
                                        display: "flex",
                                        justifyContent: "flex-end",
                                        gap: 8,
                                    }}
                                >
                                    <button
                                        type="button"
                                        onClick={closeModal}
                                        style={{
                                            border: "1px solid #DEDCD2",
                                            background: "transparent",
                                            borderRadius: 8,
                                            padding: "8px 12px",
                                            cursor: "pointer",
                                        }}
                                    >
                                        Annuler
                                    </button>
                                    <button
                                        type="button"
                                        onClick={handleApprove}
                                        style={{
                                            border: "1px solid transparent",
                                            background: accentColor,
                                            color: "#F7F4EC",
                                            borderRadius: 8,
                                            padding: "8px 12px",
                                            cursor: "pointer",
                                        }}
                                    >
                                        Valider et appliquer
                                    </button>
                                </div>
                            </>
                        ) : (
                            <>
                                <div
                                    style={{
                                        fontSize: 11,
                                        textTransform: "uppercase",
                                        letterSpacing: "0.08em",
                                        marginBottom: 8,
                                        border: "1px solid #DEDCD2",
                                        padding: "4px 8px",
                                        borderRadius: 999,
                                        width: "max-content",
                                    }}
                                >
                                    Accès Premium simulé
                                </div>
                                <h2
                                    style={{
                                        ...headingStyle,
                                        margin: "0 0 8px",
                                        fontSize: 22,
                                    }}
                                >
                                    Offre Premium
                                </h2>
                                <p style={{ margin: "0 0 10px", fontSize: 13 }}>
                                    Paiement non connecté — aucun débit.
                                </p>
                                <p
                                    style={{
                                        margin: "0 0 12px",
                                        fontSize: 12,
                                        lineHeight: 1.5,
                                    }}
                                >
                                    14,99 $ premier mois · 11,99 $ mois 2–5
                                    (environ 20 %) · 7,49 $ mois 6+ (environ 50
                                    %).
                                    <br />
                                    Offre fidélité à vie : proposition visible,
                                    non activée.
                                </p>
                                <div
                                    style={{
                                        display: "flex",
                                        justifyContent: "flex-end",
                                        gap: 8,
                                    }}
                                >
                                    <button
                                        type="button"
                                        onClick={closeModal}
                                        style={{
                                            border: "1px solid #DEDCD2",
                                            background: "transparent",
                                            borderRadius: 8,
                                            padding: "8px 12px",
                                            cursor: "pointer",
                                        }}
                                    >
                                        Fermer
                                    </button>
                                    <button
                                        type="button"
                                        onClick={() => {
                                            React.startTransition(() => {
                                                setPremiumSimulated(true)
                                                setModal(null)
                                            })
                                        }}
                                        style={{
                                            border: "1px solid transparent",
                                            background: accentColor,
                                            color: "#F7F4EC",
                                            borderRadius: 8,
                                            padding: "8px 12px",
                                            cursor: "pointer",
                                        }}
                                    >
                                        Essayer le parcours Premium (démo)
                                    </button>
                                </div>
                            </>
                        )}
                    </div>
                </div>
            )}
        </div>
    )
}

