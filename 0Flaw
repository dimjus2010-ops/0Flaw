function countWords(text: string): number {
    const trimmed = text.trim()
    if (!trimmed) return 0
    return trimmed.split(/\s+/).filter(Boolean).length
}

function runDeterministicCorrections(text: string): {
    corrected: string
    rows: ChangeRow[]
} {
    let corrected = text
    const rows: ChangeRow[] = []

    TYPO_RULES.forEach((rule) => {
        const escaped = rule.from.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
        const regex = new RegExp(
            `(^|[^\\p{L}\\p{N}_])(${escaped})(?=$|[^\\p{L}\\p{N}_])`,
            "giu"
        )
        const before = corrected
        corrected = corrected.replace(
            regex,
            (fullMatch, prefix: string, term: string) => {
                const first = term.charAt(0)
                const replacement =
                    first === first.toUpperCase()
                        ? `${rule.to.charAt(0).toUpperCase()}${rule.to.slice(1)}`
                        : rule.to
                return `${prefix}${replacement}`
            }
        )
        if (before !== corrected) {
            rows.push({
                original: rule.from,
                proposition: rule.to,
                categorie: rule.categorie,
                explication: rule.explication,
            })
        }
    })

    return { corrected, rows }
}

function isSampleText(text: string): boolean {
    return text.trim() === DEMO_SAMPLE_TEXT.trim()
}

function applyFont(font: any, fallbackFamily: string): React.CSSProperties {
